# Segredos — NUNCA versionar
#
# `.env*` e não a lista de nomes conhecidos: os padrões antigos (.env,
# .env.local, .env.*.local) deixavam passar justamente os nomes que aparecem
# numa rotação de credencial — `.env.bak`, `.env.old`, `.env.producao`,
# `.env.novo`. Nenhum deles casava com nada aqui, então nasciam já rastreáveis
# pelo git, com o segredo dentro.
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml
dist/
build/
*.egg-info/

# Node
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
playwright-report/
test-results/

# Vercel
.vercel/

# Editores / SO
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
deploy/
.vercel
